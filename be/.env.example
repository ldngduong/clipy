# Server
PORT=3210
NODE_ENV=development

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=admin
DATABASE_PASSWORD=admin123
DATABASE_NAME=clipy
DATABASE_SSL=false
TYPEORM_SYNC=false

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES=30d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:14100/callback

# CORS
CORS_ORIGINS=http://localhost:1420,http://localhost:1421,tauri://localhost,https://tauri.localhost# Cloudflare R2 (image backup for Pro plan) — leave empty to disable
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional, defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Paddle (billing) — sandbox | production
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_MONTHLY_ID=
PADDLE_PRICE_YEARLY_ID=
# Public base URL where the backend is reachable (used for the hosted checkout page)
PUBLIC_BASE_URL=http://localhost:3210
